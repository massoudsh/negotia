# Copy to .env and adjust. Never commit real secrets.
# Host port published by docker compose.
NEGOTIA_PORT=3000

# Environment badge shown in the app: production | staging | sandbox.
NEGOTIA_ENVIRONMENT=staging

# Demo mode: 1 fills a brand-new, empty database with sample trade data and
# provisions a shared demo login (demo@negotia.local / demo-mode-password).
# Set to 0 for real use. It never overwrites an existing workspace.
NEGOTIA_DEMO_MODE=1
